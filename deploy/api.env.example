# Copy to api.env on EC2 and replace every CHANGE_ME value.
# localhost inside the container is the container itself. Use a reachable DB host.
SPRING_DATASOURCE_URL=jdbc:postgresql://CHANGE_ME_DB_HOST:5432/findlocally
SPRING_DATASOURCE_USERNAME=CHANGE_ME
SPRING_DATASOURCE_PASSWORD=CHANGE_ME
# Generate once with: openssl rand -base64 32
JWT_SECRET=CHANGE_ME
APP_CORS_ALLOWED_ORIGINS=https://CHANGE_ME_DOMAIN
PASSWORD_RESET_URL=https://CHANGE_ME_DOMAIN/reset-password
AWS_REGION=ap-south-1
S3_BUCKET=CHANGE_ME_BUCKET
S3_PUBLIC_BASE_URL=https://CHANGE_ME_BUCKET.s3.ap-south-1.amazonaws.com/
SQS_ENABLED=true
SQS_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/CHANGE_ME_ACCOUNT/CHANGE_ME_QUEUE
MAIL_HOST=CHANGE_ME_SMTP_HOST
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
MAIL_FROM=CHANGE_ME
