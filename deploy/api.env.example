# Copy to api.env on EC2 and replace every CHANGE_ME value.
# localhost inside the container is the container itself. Use a reachable DB host.
SPRING_DATASOURCE_URL=jdbc:postgresql://CHANGE_ME_DB_HOST:5432/findlocally
SPRING_DATASOURCE_USERNAME=CHANGE_ME
SPRING_DATASOURCE_PASSWORD=CHANGE_ME
# Generate once with: openssl rand -base64 32
JWT_SECRET=CHANGE_ME
APP_CORS_ALLOWED_ORIGINS=https://CHANGE_ME_DOMAIN
PASSWORD_RESET_URL=https://CHANGE_ME_DOMAIN/reset-password
AWS_REGION=ap-south-1
S3_BUCKET=CHANGE_ME_BUCKET
S3_PUBLIC_BASE_URL=https://CHANGE_ME_BUCKET.s3.ap-south-1.amazonaws.com/
MAIL_HOST=CHANGE_ME_SMTP_HOST
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
MAIL_FROM=CHANGE_ME
# Proposed product defaults requiring agreement.
BOOKING_TIME_ZONE=Asia/Kolkata
BOOKING_REQUEST_RESPONSE_HOURS=24
BOOKING_QUOTATION_RESPONSE_HOURS=12
BOOKING_EXPIRY_DELAY_MS=30000
MEDIA_IMAGE_LIMIT_MIB=10
MEDIA_VIDEO_LIMIT_MIB=100
MEDIA_MAX_VIDEO_SECONDS=600
MEDIA_MAX_DIMENSION=8192
# Native deployments require ffprobe and ffmpeg. Docker includes both.
MEDIA_FFPROBE=ffprobe
MEDIA_FFMPEG=ffmpeg
